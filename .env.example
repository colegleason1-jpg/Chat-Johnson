# Optional model-id overrides (see README): CORTEX_GEMINI_MODEL, CORTEX_GROQ_MODEL, CORTEX_HF_MODEL

# Self-hosted VM (docker compose): the worker container uses these keys 24/7; the app runs with no job workers.
# CHAT_JOHNSON_JOB_WORKERS=0            (app container)   CHAT_JOHNSON_SELF_HOSTED=1
# CHAT_JOHNSON_LOCAL_ENDPOINT=http://ollama:11434/v1   CHAT_JOHNSON_LOCAL_MODEL=llama3.1:8b
# CHAT_JOHNSON_DAILY_<VENDOR>=<tokens per day>   CHAT_JOHNSON_TIMEOUT=300 (slow local models)
